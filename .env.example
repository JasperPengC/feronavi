# Compose 配置模板。复制为 .env 后设置口令；不要覆盖已有 .env。
# 推荐用 openssl rand -hex 24 生成，避免连接串中出现未编码的保留字符。
DB_PASSWORD=
APP_PORT=3000
FERONAVI_GH_OWNER=feronavi
FERONAVI_VERSION=0.2.1
FERONAVI_DB_VERSION=16-0.2.0
# 仅源码构建使用；预构建数据库镜像版本由 FERONAVI_DB_VERSION 指定。
PG_MAJOR=16
# 仅在实际使用反向代理时填写代理来源网段（逗号分隔）；默认不信任转发头。
TRUSTED_PROXY_CIDRS=
# 系统DNS返回Clash Fake-IP时可显式改为cloudflare（固定公网HTTPS DNS，仍拒绝私网/保留地址）。
OUTBOUND_DNS_MODE=system

# 宿主机开发的 DATABASE_URL / REDIS_URL / DATA_DIR 见 README。
# 自动测试单独设置 TEST_DATABASE_ADMIN_URL；测试不会使用开发库。

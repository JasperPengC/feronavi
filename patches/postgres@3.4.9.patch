diff --git a/cf/src/index.js b/cf/src/index.js
index ffbe7aef075d6037c540cbd5e8f7e298d4345cc3..d54d9d86f02c713044c68b0b8cd860eac5b943cf 100644
--- a/cf/src/index.js
+++ b/cf/src/index.js
@@ -217,8 +217,22 @@ function Postgres(a, b) {
       : move(c, reserved)
     c.reserved.release = true
 
+    let closedError = null
+      , released = false
+    c.onclose = error => {
+      closedError = error
+      while (queue.length)
+        queue.shift().reject(error)
+    }
+
     const sql = Sql(handler)
     sql.release = () => {
+      if (released)
+        return
+      released = true
+      if (closedError)
+        return
+      c.onclose = null
       c.reserved = null
       onopen(c)
     }
@@ -226,6 +240,8 @@ function Postgres(a, b) {
     return sql
 
     function handler(q) {
+      if (closedError || released)
+        return q.reject(closedError || Errors.generic('CONNECTION_RELEASED', 'The reserved connection has been released'))
       c.queue === full
         ? queue.push(q)
         : c.execute(q) || move(c, full)

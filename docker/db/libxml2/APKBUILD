# Based on Alpine 3.24 libxml2 2.13.9-r2; keep ABI 2 for PostgreSQL/libxslt/LLVM.
pkgname=libxml2
pkgver=2.13.9
pkgrel=3
pkgdesc="XML parsing library with Feronavi upstream security backports"
url="https://gitlab.gnome.org/GNOME/libxml2"
arch="all"
license="MIT"
depends_dev="zlib-dev xz-dev $pkgname-utils=$pkgver-r$pkgrel"
makedepends="python3-dev zlib-dev xz-dev"
checkdepends="perl tar"
subpackages="$pkgname-dev $pkgname-utils $pkgname-doc $pkgname-static py3-$pkgname:_python"
source="https://download.gnome.org/sources/libxml2/${pkgver%.*}/libxml2-$pkgver.tar.xz
    CVE-2026-6732-test.patch
    CVE-2026-6732.patch
    CVE-2026-74860-python-reference.patch
    CVE-2026-86138-dict-overflow.patch
    CVE-2026-86140-validation-bounds.patch
    CVE-2026-86142-xpointer-length.patch
    CVE-2026-86143-output-length.patch
    CVE-2026-86144-xinclude-options.patch
"
# secfixes:
#   2.13.9-r3:
#     - CVE-2026-74860
#     - CVE-2026-86138
#     - CVE-2026-86140
#     - CVE-2026-86142
#     - CVE-2026-86143
#     - CVE-2026-86144
#   2.13.9-r2:
#     - CVE-2026-6732

prepare() {
    default_prepare
    # Same platform exclusion as Alpine's official APKBUILD (ICU is not enabled).
    rm test/icu_parse_test.xml
}

build() {
    ./configure --prefix=/usr --sysconfdir=/etc --mandir=/usr/share/man \
        --infodir=/usr/share/info --enable-static --with-legacy \
        --with-lzma --with-zlib --with-python=/usr/bin/python3
    make -j"${DB_BUILD_JOBS:-4}"
}

check() {
    # Same unsupported-encoding fixture exclusion as Alpine's official APKBUILD.
    rm -f test/ebcdic_566012.xml
    make runtests
    sh "$startdir/tests/check-source.sh" "$builddir"
}

package() {
    make -j1 DESTDIR="$pkgdir" install
}

_python() {
    depends="python3"
    pkgdesc="libxml2 Python bindings (build/test artifact, not in runtime image)"
    amove usr/lib/python3*
}

utils() {
    replaces="libxml2"
    amove usr/bin
}

